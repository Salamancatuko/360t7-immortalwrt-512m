#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
PROG=/usr/bin/sing-box
CONF=/etc/sing-box/config.json

start_service() {
	[ -f "$CONF" ] || return 0
	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param user root
	procd_close_instance
}
